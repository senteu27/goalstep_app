<%= render "devise/shared/header" %>

<div class="show_goal_name">
<%= @goal.name %>
</div>

<% @goal.min_goals.order(:deadline).each do |min_goal| %>
<div class="show_goal">
  <div class="show_min_goals">
<div class="show_name">
<%= min_goal.name%>
</div>
<div class="show_importance">
  <% min_goal.importance.times do %>
  ★
<% end %>
</div>
<div class="show_deadline">
<%= min_goal.deadline %>
</div>
<div class=show_check>
  <%= check_box_tag "min_goal_check_#{min_goal.id}",
                  "1",
                  min_goal.check,
                  data: {
                    min_goal_id: min_goal.id,
                    update_url: min_goal_path(min_goal)
                  },
                  class: "min-goal-check" %>
</div>
</div>
</div>
<% end %>
<%= link_to "目標を編集・追加", edit_goal_path(@goal), class: "edit_goal" %>
