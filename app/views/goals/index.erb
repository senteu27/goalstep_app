<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>目標達成アプリ</title>
  </head>
  <body>
    <% if %>
    <header><%=link_to "新規登録", new_user_registration_path %></header>
    <% end %>
    <main>
      <h1>新しく目標を作ろう</h1>
      <p></p>
      <form>
        <label for="title">目標</label>
  <input class="goal" id="title" placeholder="例：ライブに行きたい。などのやりたい目標を書こう！" />

  <label>条件</label>
  <div id="conditions">
    <div class="condition-row">
      <input class="condition" placeholder="例：書いた目標実現のために達成すべきものを書こう！" />
    </div>
  </div>
  <button type="button" id="add-condition">＋ 条件を追加</button>
  <button type="button">作成する</button>
      </form>
    </main>
  </body>
</html>
<%= javascript_include_tag "plus", defer: true %>
